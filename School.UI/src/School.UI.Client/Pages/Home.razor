@page "/"

<PageTitle>School Management Dashboard</PageTitle>

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4">School Management System</h1>
        <p class="lead text-muted">Unified dashboard for Students & Teachers Affairs</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Students Card -->
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-mortarboard-fill me-2"></i>Students Affairs
                    </h4>
                </div>
                <div class="card-body d-flex flex-column">
                    <p class="card-text">Manage student records: enrollments, grades, departments, academic levels.</p>
                    <ul class="small text-muted mb-3">
                        <li>Search, filter, sort, paging</li>
                        <li>Create, edit, delete students</li>
                        <li>REST API at <code>/api/students</code></li>
                    </ul>
                    <div class="mt-auto">
                        <a class="btn btn-primary w-100" href="https://localhost:7224/students" target="_blank">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Open Students Portal
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <small class="text-muted">Running on port 7224</small>
                </div>
            </div>
        </div>

        <!-- Teachers Card -->
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-badge-fill me-2"></i>Teachers Affairs
                    </h4>
                </div>
                <div class="card-body d-flex flex-column">
                    <p class="card-text">Manage teacher records: contracts, salaries, departments, academic ranks.</p>
                    <ul class="small text-muted mb-3">
                        <li>Search, filter, sort, paging</li>
                        <li>Create, edit, delete teachers</li>
                        <li>REST API at <code>/api/teachers</code></li>
                    </ul>
                    <div class="mt-auto">
                        <a class="btn btn-success w-100" href="https://localhost:7225/teachers" target="_blank">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Open Teachers Portal
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <small class="text-muted">Running on port 7225</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">API Documentation</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a class="btn btn-outline-primary w-100" href="https://localhost:7224/swagger" target="_blank">
                                <i class="bi bi-book-fill me-2"></i>Students API Swagger
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a class="btn btn-outline-success w-100" href="https://localhost:7225/swagger" target="_blank">
                                <i class="bi bi-book-fill me-2"></i>Teachers API Swagger
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>