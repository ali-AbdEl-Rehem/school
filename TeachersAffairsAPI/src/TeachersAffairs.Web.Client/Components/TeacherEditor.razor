@* Reusable teacher form used by both the Create and Edit pages. *@

<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">First name</label>
            <InputText class="form-control" @bind-Value="Model.FirstName" />
            <ValidationMessage For="() => Model.FirstName" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Last name</label>
            <InputText class="form-control" @bind-Value="Model.LastName" />
            <ValidationMessage For="() => Model.LastName" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Employee number</label>
            <InputText class="form-control" @bind-Value="Model.EmployeeNumber" disabled="@IsEdit" />
            <ValidationMessage For="() => Model.EmployeeNumber" />
        </div>
        <div class="col-md-6">
            <label class="form-label">National ID</label>
            <InputText class="form-control" @bind-Value="Model.NationalId" disabled="@IsEdit" />
            <ValidationMessage For="() => Model.NationalId" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Email</label>
            <InputText type="email" class="form-control" @bind-Value="Model.Email" />
            <ValidationMessage For="() => Model.Email" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Phone number</label>
            <InputText class="form-control" @bind-Value="Model.PhoneNumber" />
            <ValidationMessage For="() => Model.PhoneNumber" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Date of birth</label>
            <InputDate class="form-control" @bind-Value="Model.DateOfBirth" />
            <ValidationMessage For="() => Model.DateOfBirth" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Gender</label>
            <InputSelect class="form-select" @bind-Value="Model.Gender">
                <option value="@Gender.Unspecified">-- select --</option>
                <option value="@Gender.Male">Male</option>
                <option value="@Gender.Female">Female</option>
            </InputSelect>
            <ValidationMessage For="() => Model.Gender" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Level</label>
            <InputSelect class="form-select" @bind-Value="Model.Level">
                @foreach (var level in Enum.GetValues<TeacherLevel>())
                {
                    <option value="@level">@level</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Model.Level" />
        </div>

        <div class="col-md-5">
            <label class="form-label">Department</label>
            <InputText class="form-control" list="department-options" @bind-Value="Model.Department" />
            <datalist id="department-options">
                @foreach (var d in Departments)
                {
                    <option value="@d" />
                }
            </datalist>
            <ValidationMessage For="() => Model.Department" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Salary</label>
            <InputNumber class="form-control" step="100" @bind-Value="Model.Salary" />
            <ValidationMessage For="() => Model.Salary" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Hire date</label>
            <InputDate class="form-control" @bind-Value="Model.HireDate" />
            <ValidationMessage For="() => Model.HireDate" />
        </div>

        <div class="col-12 form-check ms-2">
            <InputCheckbox class="form-check-input" id="isActive" @bind-Value="Model.IsActive" />
            <label class="form-check-label" for="isActive">Active teacher</label>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@Busy">
            @if (Busy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            @SubmitLabel
        </button>
        <a class="btn btn-outline-secondary" href="/teachers">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public TeacherFormModel Model { get; set; } = default!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Save";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public IReadOnlyList<string> Departments { get; set; } = [];
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    private Task HandleValidSubmitAsync() => OnValidSubmit.InvokeAsync();
}